{
  "manifest_version": 3,
  "name": "CommitJr Atas",
  "version": "3.4.5",
  "description": "Transcrições automáticas no Google Meet e geração de Atas de Reunião com IA | Commit Jr.",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup/index.html"
  },
  "sidebar_action": {
    "default_panel": "side-panel/index.html",
    "default_title": "CommitJr Atas",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "background": {
    "scripts": [
      "background-script/index.js"
    ],
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png",
        "icons/pull-mascot.svg",
        "meetings.html",
        "templates/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "transcriptonic@wescleyj.github.io",
      "strict_min_version": "115.0"
    }
  }
}
